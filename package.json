{
  "name": "codepilot",
  "private": true,
  "scripts": {
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "build:markdown": "node tools/build-markdown-renderer.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "temml": "0.14.0"
  }
}
