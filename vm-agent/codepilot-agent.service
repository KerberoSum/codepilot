[Unit]
Description=CodePilot Remote Worker API v3.2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codepilot-agent
Group=codepilot-agent
WorkingDirectory=/srv/codepilot-agent
EnvironmentFile=/etc/codepilot-agent.env
Environment=HOME=/srv/codepilot-agent
Environment=PATH=/srv/codepilot-agent/.trailblaze/bin:/srv/codepilot-agent/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/python3 -m uvicorn agent_server:app --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/codepilot-workspace /srv/codepilot-agent

[Install]
WantedBy=multi-user.target
